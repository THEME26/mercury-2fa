{
  "name": "mercury-2fa",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "description": "离线 TOTP 验证码扩展，支持 Chrome 与 Edge",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "build:edge": "wxt build -b edge",
    "zip": "wxt zip",
    "test": "vitest run",
    "test:watch": "vitest",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "assets": "node tools/make-assets.mjs",
    "pack": "npm run build:edge && wxt zip -b edge",
    "shots": "node tools/shoot-store.mjs",
    "prebuild": "node tools/sync-licenses.mjs",
    "prebuild:edge": "node tools/sync-licenses.mjs",
    "licenses": "node tools/sync-licenses.mjs"
  },
  "dependencies": {
    "hash-wasm": "^4.13.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zxing-wasm": "^3.1.8"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "jsdom": "^31.0.1",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2",
    "wxt": "^0.21.5"
  },
  "license": "MIT"
}
